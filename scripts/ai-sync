#!/usr/bin/env python3
"""Inspect or install local OpenCode links to Git-pinned skill sources."""

import argparse
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile


def git(root, *args):
    # Do not change the user's Git config to accommodate a differently owned repo.
    return subprocess.run(
        ["git", "--no-optional-locks", "-c", f"safe.directory={root}",
         "-C", str(root), *args],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=True,
    ).stdout


def module_gitlinks(root):
    links = {}
    for entry in git(root, "ls-files", "--stage", "-z").split(b"\0"):
        if not entry:
            continue
        metadata, name = entry.split(b"\t", 1)
        match = re.fullmatch(rb"160000 ([0-9a-f]{40}) [0-3]", metadata)
        path = os.fsdecode(name)
        if match and path.startswith("src/configuration/"):
            if metadata[-1:] != b"0" or path in links:
                raise ValueError(f"unmerged or duplicate submodule gitlink: {path}")
            links[path] = match.group(1).decode("ascii")
    return links


def skill_files(module):
    for base, dirs, _ in os.walk(module, followlinks=False):
        dirs[:] = sorted(d for d in dirs if d != ".git" and
                         not (Path(base) / d).is_symlink())
        if Path(base).name != ".skills":
            continue
        for name in dirs:
            item = Path(base) / name
            md = item / "SKILL.md"
            if md.is_file() and not md.is_symlink():
                yield item
        dirs[:] = []


def managed_link(value, name, modules):
    """Recognize only canonical links to Git-tracked source locations."""
    for module in modules:
        prefix = f"../../{module}/"
        if value.startswith(prefix):
            middle = value[len(prefix):]
            parts = middle.split("/")
            if (len(parts) >= 2 and parts[-2:] == [".skills", name]
                    and all(p not in ("", ".", "..") for p in parts[:-2])):
                return True
    return False


def inventory(root):
    problems = []
    modules = module_gitlinks(root)
    sources = {}
    for path, sha in sorted(modules.items()):
        module = root / path
        print(f"SOURCE {path}: gitlink {sha}")
        if module.is_symlink() or not module.is_dir():
            problems.append(f"{path}: submodule directory is absent or a symlink")
            continue
        if not (module / ".git").exists():
            problems.append(f"{path}: submodule Git metadata is missing (initialize it first)")
            continue
        try:
            head = git(module, "rev-parse", "--verify", "HEAD").decode().strip()
        except subprocess.CalledProcessError:
            problems.append(f"{path}: cannot read submodule HEAD")
            continue
        print(f"  HEAD {head}" + (" (matches gitlink)" if head == sha else " (DIFFERS from gitlink)"))
        if head != sha:
            problems.append(f"{path}: checkout HEAD differs from Git gitlink; pin/update explicitly")
        # HEAD alone is not enough: local staged, unstaged, untracked and
        # ignored skill contents must not be attributed to that Git commit.
        scope = ":(glob)**/.skills/**"
        try:
            dirty = git(module, "status", "--porcelain=v1", "-z",
                        "--untracked-files=all", "--", scope)
            # Git status omits ignored files, including a rogue SKILL.md or
            # unpinned support files inside an otherwise tracked skill.
            ignored = git(module, "ls-files", "--others", "--ignored",
                          "--exclude-standard", "-z", "--", scope)
        except subprocess.CalledProcessError:
            problems.append(f"{path}: cannot verify skill working-tree state")
            continue
        if dirty:
            for entry in dirty.split(b"\0"):
                if entry:
                    print(f"  DIRTY {os.fsdecode(entry)}")
            problems.append(f"{path}: staged, unstaged or untracked skill changes; "
                            "sources do not match the pinned Git commit")
        if ignored:
            for entry in ignored.split(b"\0"):
                if entry:
                    print(f"  IGNORED {os.fsdecode(entry)}")
            problems.append(f"{path}: ignored skill files are not in the pinned Git commit")
        for item in skill_files(module):
            skill_id = item.name
            print(f"  SKILL {skill_id} <- {item.relative_to(root)}")
            if skill_id in sources:
                problems.append(f"conflicting skill ID {skill_id}: "
                                f"{sources[skill_id].relative_to(root)} and {item.relative_to(root)}")
            else:
                sources[skill_id] = item
    return modules, sources, problems


def plan(root):
    modules, sources, problems = inventory(root)
    skills = root / ".opencode" / "skills"
    opencode = root / ".opencode"
    if (opencode.is_symlink() or (opencode.exists() and not opencode.is_dir()) or
            skills.is_symlink() or (skills.exists() and not skills.is_dir())):
        problems.append(".opencode/skills: not a real directory (or parent is a symlink)")
        return [], problems, [], [], []
    actions = []
    foreign_broken = []
    foreign = []
    legacy_shared = []
    for name, source in sorted(sources.items()):
        target = skills / name
        expected = os.path.relpath(source, skills)
        if target.is_symlink():
            actual = os.readlink(target)
            if actual == expected:
                print(f"OK       {target.relative_to(root)} -> {expected}")
            elif actual == f"../../.bundle/skills/{name}":
                problems.append(f"{target.relative_to(root)}: legacy shared-skill link "
                                f"{actual!r} conflicts with package skill {expected!r}; kept")
            elif managed_link(actual, name, modules):
                print(f"UPDATE   {target.relative_to(root)}: {actual} -> {expected}")
                actions.append(("update", target, expected, actual))
            else:
                problems.append(f"{target.relative_to(root)}: foreign symlink {actual!r} "
                                f"conflicts with expected {expected!r}")
        elif target.exists():
            problems.append(f"{target.relative_to(root)}: existing file/directory blocks "
                            f"expected link -> {expected}")
        else:
            print(f"MISSING  {target.relative_to(root)} -> {expected}")
            actions.append(("create", target, expected, None))
    if skills.is_dir():
        for target in sorted(skills.iterdir()):
            if not target.is_symlink() or target.name in sources:
                continue
            actual = os.readlink(target)
            if actual == f"../../.bundle/skills/{target.name}":
                value = f"{target.relative_to(root)} -> {actual}"
                print(f"LEGACY   {value} (shared skills are global; remove manually after verification)")
                legacy_shared.append(value)
                problems.append(f"{target.relative_to(root)}: legacy .bundle skill link; "
                                "verify the global skill and remove this link manually")
            elif managed_link(actual, target.name, modules):
                # A skill missing from the worktree is not proof it was deleted
                # in the pinned commit (it could be a partial/dirty checkout).
                print(f"STALE    {target.relative_to(root)} -> {actual} (kept)")
                problems.append(f"{target.relative_to(root)}: stale managed link; "
                                "inspect the Git-pinned source and remove manually if obsolete")
            elif not target.exists():
                foreign_broken.append(f"{target.relative_to(root)} -> {actual}")
            else:
                foreign.append(f"{target.relative_to(root)} -> {actual}")
    for value in foreign:
        print(f"FOREIGN  {value} (kept)")
    for value in foreign_broken:
        print(f"BROKEN   {value} (foreign; kept)")
    return actions, problems, foreign_broken, foreign, legacy_shared


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "release":
        print("ai-sync: release is disabled: no automatic commit, push, or course merge. "
              "Use 'scripts/ai-sync check' and distribute reviewed package gitlinks "
              "through explicit template merges (see README.md).", file=sys.stderr)
        return 2
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", nargs="?", choices=("check", "sync"), default="check")
    parser.add_argument("--workspace", type=Path, default=Path(__file__).resolve().parent.parent,
                        help="repository root (defaults to the directory containing this script)")
    args = parser.parse_args()
    root = args.workspace.resolve()
    try:
        actual_root = git(root, "rev-parse", "--show-toplevel").decode().strip()
        if actual_root != str(root):
            raise ValueError(f"workspace is not the repository root: {root}")
        actions, problems, foreign_broken, _, _ = plan(root)
        if args.command == "check":
            for action, target, _, _ in actions:
                problems.append(f"{target.relative_to(root)}: needs {action}")
            problems.extend(f"broken foreign symlink: {link}" for link in foreign_broken)
        elif not problems:
            skills = root / ".opencode" / "skills"
            parent = skills if skills.is_dir() else (
                skills.parent if skills.parent.exists() else root)
            if not parent.is_dir() or not os.access(parent, os.W_OK | os.X_OK):
                problems.append(f"cannot write OpenCode skills directory: {parent}")
            if not problems and actions:
                skills.mkdir(parents=True, exist_ok=True)
                for action, target, expected, original in actions:
                    if action == "create":
                        os.symlink(expected, target)  # never replace a foreign entry
                    else:  # update a recognizable managed link
                        if not target.is_symlink() or os.readlink(target) != original:
                            raise ValueError(f"link changed since preflight: {target}")
                        with tempfile.TemporaryDirectory(prefix=".ai-sync-", dir=skills) as tmp:
                            replacement = Path(tmp) / target.name
                            os.symlink(expected, replacement)
                            # On failure, the original link remains intact.
                            if not target.is_symlink() or os.readlink(target) != original:
                                raise ValueError(f"link changed since preflight: {target}")
                            os.replace(replacement, target)
                print(f"Synced {len(actions)} managed skill link change(s).")
        for problem in problems:
            print(f"ERROR    {problem}", file=sys.stderr)
        if problems:
            return 1
        print("Check OK: all managed links and Git-pinned sources are consistent." if
              args.command == "check" else "Sync OK: foreign links preserved.")
        return 0
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        print(f"ai-sync: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
